theme = OneHalfDark
font-family = Noto Sans Mono Regular
# font-size=20

keybind = shift+ctrl+r=reload_config

keybind = shift+ctrl+j=new_split:left
keybind = shift+ctrl+k=new_split:down
keybind = shift+ctrl+l=new_split:up
keybind = shift+ctrl+;=new_split:right

keybind = ctrl+left=goto_split:left
keybind = ctrl+down=goto_split:bottom
keybind = ctrl+up=goto_split:top
keybind = ctrl+right=goto_split:right

window-decoration=false
